<?xml version="1.0"?>
<sdf version="1.6">
  <world name="recon_world">

    <!-- The robot is ~12 cm wide, so use a small, accurate time step. -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <include><uri>model://sun</uri></include>

    <!-- flat ground with a grid so the robot's motion is easy to see -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>


    <!-- publishes /gazebo/model_states so the robot pose can be plotted/echoed -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <!-- ===== miniature office: 6 m x 5 m, three rooms, doorways 0.8 m wide ===== -->
    <model name="wall_n"><static>true</static><pose>2.0 2.5 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>6.06 0.06 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.06 0.06 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>2.0 -2.5 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>6.06 0.06 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.06 0.06 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-1.0 0.0 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.06 5.0 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.06 5.0 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>5.0 0.0 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.06 5.0 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.06 5.0 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="part1a"><static>true</static><pose>2.0 -0.95 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.06 3.1 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.06 3.1 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Turquoise</name></script></material></visual></link></model>
    <model name="part1b"><static>true</static><pose>2.0 1.95 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.06 1.1 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.06 1.1 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Turquoise</name></script></material></visual></link></model>
    <model name="part2a"><static>true</static><pose>2.75 -0.3 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>1.5 0.06 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.5 0.06 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Turquoise</name></script></material></visual></link></model>
    <model name="part2b"><static>true</static><pose>4.65 -0.3 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.7 0.06 0.4</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.7 0.06 0.4</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Turquoise</name></script></material></visual></link></model>
    <model name="desk_a"><static>true</static><pose>0.9 1.7 0.11 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.6 0.3 0.22</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.6 0.3 0.22</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link></model>
    <model name="cabinet_a"><static>true</static><pose>-0.6 -1.9 0.19 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.35 0.25 0.38</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.35 0.25 0.38</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual></link></model>
    <model name="table_a"><static>true</static><pose>0.9 -1.2 0.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.22</radius><length>0.20</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.22</radius><length>0.20</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual></link></model>
    <model name="shelf_a"><static>true</static><pose>-0.75 0.9 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 0.8 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 0.8 0.3</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Purple</name></script></material></visual></link></model>
    <model name="desk_b1"><static>true</static><pose>3.0 1.9 0.11 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.7 0.3 0.22</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.7 0.3 0.22</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link></model>
    <model name="desk_b2"><static>true</static><pose>4.4 1.1 0.11 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.3 0.7 0.22</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 0.7 0.22</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link></model>
    <model name="plant_b"><static>true</static><pose>4.65 2.2 0.175 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link></model>
    <model name="crate_c1"><static>true</static><pose>3.0 -1.6 0.125 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.35 0.35 0.25</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.35 0.35 0.25</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="crate_c2"><static>true</static><pose>4.2 -1.9 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.5 0.25 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 0.25 0.3</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual></link></model>
    <model name="pillar_c"><static>true</static><pose>4.55 -1.0 0.2 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.4</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.4</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual></link></model>

    <gui>
      <camera name="user_camera">
        <!-- overview of the whole office -->
        <pose>2.0 -0.3 6.5 0 1.5 1.5708</pose>
      </camera>
    </gui>

  </world>
</sdf>
