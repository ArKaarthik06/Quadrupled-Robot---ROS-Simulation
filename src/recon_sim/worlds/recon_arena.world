<?xml version="1.0"?>
<sdf version="1.6">
  <world name="recon_world">

    <!-- The robot is ~12 cm wide, so use a small, accurate time step. -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <include><uri>model://sun</uri></include>

    <!-- flat ground with a grid so the robot's motion is easy to see -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- 10 cm tape ruler along +x (red every 50 cm) so the walking distance is easy to see -->
    <model name="ruler">
      <static>true</static>
      <link name="link">
        <visual name="tick_-10"><pose>-1.00 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_-9"><pose>-0.90 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_-8"><pose>-0.80 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_-7"><pose>-0.70 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_-6"><pose>-0.60 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_-5"><pose>-0.50 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_-4"><pose>-0.40 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_-3"><pose>-0.30 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_-2"><pose>-0.20 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_-1"><pose>-0.10 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_0"><pose>0.00 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_1"><pose>0.10 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_2"><pose>0.20 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_3"><pose>0.30 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_4"><pose>0.40 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_5"><pose>0.50 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_6"><pose>0.60 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_7"><pose>0.70 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_8"><pose>0.80 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_9"><pose>0.90 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_10"><pose>1.00 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_11"><pose>1.10 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_12"><pose>1.20 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_13"><pose>1.30 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_14"><pose>1.40 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_15"><pose>1.50 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_16"><pose>1.60 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_17"><pose>1.70 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_18"><pose>1.80 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_19"><pose>1.90 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_20"><pose>2.00 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_21"><pose>2.10 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_22"><pose>2.20 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_23"><pose>2.30 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_24"><pose>2.40 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_25"><pose>2.50 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="tick_26"><pose>2.60 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_27"><pose>2.70 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_28"><pose>2.80 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_29"><pose>2.90 0 0.0006 0 0 0</pose><geometry><box><size>0.003 0.12 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="tick_30"><pose>3.00 0 0.0006 0 0 0</pose><geometry><box><size>0.006 0.24 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="axis"><pose>1.0 0 0.0005 0 0 0</pose><geometry><box><size>4.1 0.004 0.001</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
      </link>
    </model>

    <!-- publishes /gazebo/model_states so the robot pose can be plotted/echoed -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <!-- ===== arena: 4 m x 3 m room with obstacles ===== -->
    <model name="wall_n"><static>true</static><pose>1.0 1.5 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>4.1 0.05 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>4.1 0.05 0.3</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>1.0 -1.5 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>4.1 0.05 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>4.1 0.05 0.3</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>3.0 0.0 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.05 3.0 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.05 3.0 0.3</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-1.0 0.0 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.05 3.0 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.05 3.0 0.3</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual></link></model>
    <model name="block1"><static>true</static><pose>0.9 0.5 0.06 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.15 0.15 0.12</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.15 0.15 0.12</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual></link></model>
    <model name="block2"><static>true</static><pose>1.6 -0.6 0.08 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 0.1 0.16</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 0.1 0.16</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual></link></model>
    <model name="block3"><static>true</static><pose>2.3 0.7 0.05 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.12 0.12 0.10</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.12 0.12 0.10</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Purple</name></script></material></visual></link></model>
    <model name="wall_mid"><static>true</static><pose>1.8 0.0 0.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.04 0.8 0.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.04 0.8 0.2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Turquoise</name></script></material></visual></link></model>
    <model name="bar"><static>true</static><pose>0.2 -0.8 0.1 0 0 0.4</pose><link name="l">
      <collision name="c"><geometry><box><size>0.6 0.04 0.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.6 0.04 0.2</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual></link></model>
    <model name="pillar1"><static>true</static><pose>0.5 -0.3 0.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.07</radius><length>0.2</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.07</radius><length>0.2</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual></link></model>
    <model name="pillar2"><static>true</static><pose>2.6 -1.0 0.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.2</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.2</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual></link></model>
    <model name="pillar3"><static>true</static><pose>1.2 1.0 0.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><cylinder><radius>0.06</radius><length>0.2</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.06</radius><length>0.2</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual></link></model>

    <gui>
      <camera name="user_camera">
        <!-- fixed overview of the whole arena (no camera shake). To follow the robot instead:
             right-click "recon" in the model list -> Follow. -->
        <pose>1.0 -2.4 2.0 0 0.75 1.5708</pose>
      </camera>
    </gui>

  </world>
</sdf>
